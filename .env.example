# Porta exposta no host para acessar a aplicação
HOST_PORT=5000

# Senha obrigatória para liberar acesso às telas e Socket.IO
APP_ACCESS_PASSWORD=

# Chave secreta do Flask (obrigatória em produção)
FLASK_SECRET_KEY=

# Em produção com HTTPS (Coolify), use true
SESSION_COOKIE_SECURE=false

# Obrigatória para habilitar AI World Generator (/worldgen)
OPENAI_API_KEY=
